# 챠밍 백엔드 환경변수 예시 (.env 로 복사 후 값 채움)

# ===== Application =====
APP_NAME=Charming
APP_HOST=0.0.0.0
APP_PORT=8000
RELOAD=true
LOG_LEVEL=INFO
ENV=development

# ===== CORS =====
# 프론트 origin(s). 프리뷰 배포 시 https://your-frontend.vercel.app 추가.
# pydantic-settings 는 JSON list 로 파싱하므로 아래 형태 유지.
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# ===== Security =====
INTERNAL_API_SECRET=dev-secret-change-me
JWT_SECRET=dev-jwt-secret-change-me

# ===== Supabase =====
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ===== OpenAI =====
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
