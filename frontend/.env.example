# 사이다 프론트엔드 환경변수 예시
# 실제 값은 .env.local (gitignored)

# ===== Backend API =====
NEXT_PUBLIC_API_URL=http://localhost:8000

# ===== WebRTC 시그널링 (Socket.IO) =====
# 백엔드가 붙어있는 origin. 프리뷰 배포시 https://your-backend.fly.dev
NEXT_PUBLIC_SIGNALING_URL=http://localhost:8000

# ===== WebRTC TURN (선택 · 원격 페어 테스트 시 필요) =====
# 방식 A (권장, metered.ca REST) — 매번 credential 발급받아 여러 릴레이 활용
#   URL 형태: https://<subdomain>.metered.live/api/v1/turn/credentials?apiKey=<key>
NEXT_PUBLIC_TURN_API_URL=

# 방식 B (정적, 대체용) — 위 API URL 이 비었을 때만 사용
#   예: turn:global.relay.metered.ca:80  /  turns:global.relay.metered.ca:443
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# ===== Supabase (public keys only) =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ===== Toss Payments (client key only) =====
NEXT_PUBLIC_TOSS_CLIENT_KEY=

# ===== Internal (Server Actions / API Routes only) =====
# 아래는 서버 사이드 전용, NEXT_PUBLIC_ 접두 X
INTERNAL_API_SECRET=change-me-in-prod
